# Google Gemini API Key (Gemini 1.5 Flash Vision & Structured Output)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Commercial Background Replacement APIs
# Photoroom API: https://www.photoroom.com/api/
PHOTOROOM_API_KEY=

# Replicate API Token: https://replicate.com/
REPLICATE_API_TOKEN=

# Server Configuration
PORT=5000

# Optional: Sequence Gemini Vision text OCR detection to enrich image generation prompt (default: false for fastest parallel processing)
ENRICH_IMAGE_PROMPT=false
